    "empty_command": "native calloc-backed empty builders serialize opt and p as empty strings, not arrays",
    "empty_status": "safe model returns empty cols/dat arrays; native zero-item builder pointers remain NULL and reach string first-byte dereference (static source inference, not observed native fault)",
    "number_to_string": "native gree_json numeric array elements use sprintf%d before dispatch; selected string commands echo decimal strings",
    "discovery_metadata": "UID and peer cid are cached from completed encrypted transactions; plaintext scans reuse them, ignoring scan uid/cid; malformed transactions leave model metadata unchanged",
    "late_schedule": "normal source record scheduling normalizes WorkState>1 to3 with explicitly zero synthetic occupancy; requested p remains unchanged",
    "native_board_queue_timeout": "r404; no appended borderout/x/y/doorposition",
    "synthetic_board_queue_success": "r200; source ACK appends borderout,x,y and doorposition when cumulative selector slot>4. Chosen raw points0.0,0.0, position0, borderout0; valid synthetic UART flag gives late doorenable1 except source post-mode1 clearing. Late setinstalltype/mode7 suppress appended coordinates. No physical measurement claim.",
    "unknown_status": "retain column and numeric zero; not physical sensor support",
